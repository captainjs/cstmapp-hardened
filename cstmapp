#!/bin/python3
import yaml
import json
import sys
import subprocess
import argparse
import os
import re
import time
import inspect

from truenas_api_client import Client

# ClientException import is version-dependent; fall back to Exception.
try:
    from truenas_api_client.exc import ClientException
except Exception:  # pragma: no cover
    try:
        from truenas_api_client import ClientException
    except Exception:
        ClientException = Exception


class Middleware:
    """In-process middleware client.

    Replaces the `midclt call ...` subprocess path, which gets SIGKILLed on
    large argv payloads (e.g. multi-service app.create/update) on TrueNAS
    25.10.x. Going in-process avoids the CLI entirely.
    """

    def __init__(self):
        # Detect once whether Client.call accepts a progress callback kwarg.
        try:
            self._supports_callback = "callback" in inspect.signature(Client.call).parameters
        except (ValueError, TypeError):
            self._supports_callback = False

    def call(self, method, *params):
        with Client() as c:
            return c.call(method, *params)

    def call_job(self, method, *params, timeout=600):
        def _progress(job):
            p = (job or {}).get("progress") or {}
            print(f"\r\x1b[K{p.get('description', '')} "
                  f"(progress: {p.get('percent', 0)}% -> {job.get('state')})", end="")

        with Client() as c:
            if self._supports_callback:
                res = c.call(method, *params, job=True, callback=_progress, timeout=timeout)
            else:
                res = c.call(method, *params, job=True, timeout=timeout)
        print()
        return res


class AppManager:
    def __init__(self):
        self.mw = Middleware()

    def query_apps(self, filters):
        # filters is a Python list (middleware query-filters syntax).
        return self.mw.call("app.query", filters)

    def get_app_config(self, app_name):
        if not self.check_app_exists(app_name):
            print(f"Error: App '{app_name}' does not exist.")
            sys.exit(1)
        return self.mw.call("app.config", app_name)

    def check_app_exists(self, app_name):
        return len(self.query_apps([["name", "=", app_name]])) > 0

    def validate_app_name(self, app_name):
        if not app_name or not isinstance(app_name, str):
            print("Error: App name must be a non-empty string.")
            sys.exit(1)
        if not re.match(r'^[a-z]([-a-z0-9]*[a-z0-9])?$', app_name) or len(app_name) > 40:
            print("Error: App name must be 1-40 characters long, start with a letter, "
                  "end with alphanumeric, and contain only lowercase letters, numbers "
                  "and hyphens (not at start/end).")
            sys.exit(1)

    def find_compose_file(self, file_path):
        if not file_path:
            candidates = ['compose.yml', 'compose.yaml', 'docker-compose.yml', 'docker-compose.yaml']
            found = [f for f in candidates if os.path.exists(f)]
            if not found:
                print("Error: No compose file found. Use --file to specify one.")
                sys.exit(1)
            elif len(found) > 1:
                print(f"Error: Multiple compose files found: {', '.join(found)}. Use --file to specify one.")
                sys.exit(1)
            file_path = found[0]
        return file_path

    def read_compose_file(self, file_path):
        file_path = self.find_compose_file(file_path)
        abs_path = os.path.abspath(file_path)
        try:
            with open(abs_path, 'r') as file:
                compose_file = yaml.safe_load(file)
        except FileNotFoundError:
            print(f"Error: Compose file '{file_path}' not found.")
            sys.exit(1)
        except yaml.YAMLError as e:
            print(f"Error: Invalid YAML in compose file: {e}")
            sys.exit(1)
        except Exception as e:
            print(f"Error reading compose file: {e}")
            sys.exit(1)
        return yaml.dump(compose_file), compose_file

    # --- pre-flight container-name conflict check ---------------------------
    def get_compose_container_names(self, compose_dict):
        names = []
        for inc in (compose_dict.get("include") or []):
            path = inc.get("path") if isinstance(inc, dict) else inc
            if path and os.path.exists(path):
                with open(path) as f:
                    sub = yaml.safe_load(f) or {}
                names += self.get_compose_container_names(sub)
        for svc in (compose_dict.get("services") or {}).values():
            if isinstance(svc, dict) and svc.get("container_name"):
                names.append(svc["container_name"])
        return names

    def check_container_conflicts(self, compose_dict, app_name, force=False):
        names = self.get_compose_container_names(compose_dict)
        if not names:
            return
        pattern = "^(" + "|".join(names) + ")$"
        proc = subprocess.run(
            ["docker", "ps", "-aq", "--filter", f"name={pattern}"],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
        existing_ids = proc.stdout.decode().split()
        if not existing_ids:
            return

        if not force:
            print(f"Error: {len(existing_ids)} container(s) already exist with name(s) app '{app_name}' needs, "
                  f"and are NOT tracked by middleware for this app:")
            detail = subprocess.run(
                ["docker", "ps", "-a", "--filter", f"name={pattern}",
                 "--format", "  {{.Names}}\t{{.State}}\t{{.Status}}"],
                stdout=subprocess.PIPE
            )
            print(detail.stdout.decode())
            print("Refusing to proceed and risk app.create/app.update hanging on a name conflict.")
            print("Re-run with --force to remove these containers first, then retry.")
            sys.exit(1)
        else:
            print(f"--force given: removing {len(existing_ids)} conflicting container(s) before proceeding...")
            for cid in existing_ids:
                rm = subprocess.run(["docker", "rm", "-f", cid], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                if rm.returncode != 0:
                    print(f"Error removing container {cid}: {rm.stderr.decode()}")
                    sys.exit(1)
    # --- end conflict check --------------------------------------------------


class CommandHandler:
    def __init__(self):
        self.app_manager = AppManager()

    def list_apps(self, all):
        filters = [] if all else [["custom_app", "=", True]]
        app_list = self.app_manager.query_apps(filters)
        if len(app_list) > 0:
            print("Deployed Custom Apps:")
            print("  APP_NAME                                 STATE      APP")
            for app in app_list:
                print(f'  {app["name"]:40s} {app["state"]:10s} {app["metadata"]["name"]}')
        else:
            print("No deployed custom apps found.")

    def inspect_app(self, app_name, is_compact, is_yaml):
        app_details = self.app_manager.query_apps([["name", "=", app_name]])
        if not app_details:
            print(f"Error: App '{app_name}' not found.")
            sys.exit(1)
        if is_yaml:
            print(yaml.dump(app_details[0]))
        elif is_compact:
            print(json.dumps(app_details[0]))
        else:
            print(json.dumps(app_details[0], indent=4))

    def config_app(self, app_name, is_compact, is_yaml):
        app_config = self.app_manager.get_app_config(app_name)
        if not app_config:
            print(f"Error: App '{app_name}' not found.")
            sys.exit(1)
        if is_yaml:
            print(yaml.dump(app_config))
        elif is_compact:
            print(json.dumps(app_config))
        else:
            print(json.dumps(app_config, indent=4))

    def create_app(self, app_name, file_path, force=False):
        self.app_manager.validate_app_name(app_name)
        if self.app_manager.check_app_exists(app_name):
            print(f"Error: App '{app_name}' already exists.")
            sys.exit(1)
        compose_file_str, compose_dict = self.app_manager.read_compose_file(file_path)
        self.app_manager.check_container_conflicts(compose_dict, app_name, force=force)
        res = self.app_manager.mw.call_job("app.create", {
            "app_name": app_name,
            "custom_app": True,
            "custom_compose_config_string": compose_file_str,
        })
        name = res.get("name", app_name) if isinstance(res, dict) else app_name
        print(f"JOB SUCCESS: {name}")

    def update_app(self, app_name, file_path, force=False):
        if not self.app_manager.check_app_exists(app_name):
            print(f"Error: App '{app_name}' does not exist.")
            sys.exit(1)
        compose_file_str, _ = self.app_manager.read_compose_file(file_path)
        self.app_manager.mw.call_job("app.update", app_name, {
            "custom_compose_config_string": compose_file_str,
        })
        print(f"JOB SUCCESS: {app_name}")

    def execute_app_command(self, app_name, command):
        if not self.app_manager.check_app_exists(app_name):
            print(f"Error: App '{app_name}' does not exist.")
            sys.exit(1)
        self.app_manager.mw.call_job(f"app.{command}", app_name)
        print(f"JOB SUCCESS: {app_name} ({command})")

    def execute_compose_command(self, app_name, file_path, unknown_args):
        compose_file = self.app_manager.find_compose_file(file_path)
        cmd = ['docker', 'compose', '-f', compose_file, '-p', f'ix-{app_name}'] + unknown_args
        print(cmd)
        subprocess.run(cmd)


class ArgumentParser:
    @staticmethod
    def configure_argparser():
        parser = argparse.ArgumentParser(description='TrueNAS Custom App Control (hardened)')
        subparsers = parser.add_subparsers(dest='command', help='Available commands')

        create_parser = subparsers.add_parser('create', help='Create a new app')
        create_parser.add_argument('--file', '-f', help='Docker compose file')
        create_parser.add_argument('--force', action='store_true', help='Remove conflicting containers before creating')
        create_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        update_parser = subparsers.add_parser('update', help='Update an existing app')
        update_parser.add_argument('--file', '-f', help='Docker compose file')
        update_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        up_parser = subparsers.add_parser('up', help='Create a new app or update an existing app')
        up_parser.add_argument('--file', '-f', help='Docker compose file')
        up_parser.add_argument('--force', action='store_true', help='Remove conflicting containers before creating (only applies if app does not yet exist)')
        up_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        delete_parser = subparsers.add_parser('delete', help='Delete an app')
        delete_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        down_parser = subparsers.add_parser('down', help='Delete an app')
        down_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        stop_parser = subparsers.add_parser('stop', help='Stop an app')
        stop_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        start_parser = subparsers.add_parser('start', help='Start an app')
        start_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        restart_parser = subparsers.add_parser('restart', help='Restart an app')
        restart_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        redeploy_parser = subparsers.add_parser('redeploy', help='Redeploy an app')
        redeploy_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        list_parser = subparsers.add_parser('list', help='List all deployed custom apps')
        list_parser.add_argument('--all', '-a', action='store_true', help='List all apps including non-custom apps')

        inspect_parser = subparsers.add_parser('inspect', help='Inspect custom app')
        inspect_parser.add_argument('--compact', '-c', action='store_true', help='Compact json output')
        inspect_parser.add_argument('--yaml', action='store_true', help='Yaml output')
        inspect_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        config_parser = subparsers.add_parser('config', help='Get configuration of an app')
        config_parser.add_argument('--compact', '-c', action='store_true', help='Compact json output')
        config_parser.add_argument('--yaml', action='store_true', help='Yaml output')
        config_parser.add_argument('app_name', nargs='?', help='Name of the app (defaults to current directory name)')

        compose_parser = subparsers.add_parser('compose', help='Delegate command to `docker compose`')
        compose_parser.add_argument('--file', '-f', help='Docker compose file')
        compose_parser.add_argument('--app_name', help='Name of the app (defaults to current directory name)')

        args, unknown_args = parser.parse_known_args()

        if not args.command:
            parser.print_help()
            exit(0)

        return args, unknown_args


def main():
    args, unknown_args = ArgumentParser.configure_argparser()
    handler = CommandHandler()

    if hasattr(args, 'app_name') and not args.app_name:
        args.app_name = os.path.basename(os.getcwd())

    force = getattr(args, 'force', False)

    try:
        if args.command == 'list':
            handler.list_apps(args.all)
        elif args.command == 'inspect':
            handler.inspect_app(args.app_name, args.compact, args.yaml)
        elif args.command == 'config':
            handler.config_app(args.app_name, args.compact, args.yaml)
        elif args.command == 'create':
            handler.create_app(args.app_name, args.file, force=force)
        elif args.command == 'update':
            handler.update_app(args.app_name, args.file)
        elif args.command == 'up':
            if not handler.app_manager.check_app_exists(args.app_name):
                handler.create_app(args.app_name, args.file, force=force)
            else:
                handler.update_app(args.app_name, args.file)
        elif args.command == 'down':
            handler.execute_app_command(args.app_name, 'delete')
        elif args.command == 'restart':
            handler.execute_app_command(args.app_name, 'stop')
            handler.execute_app_command(args.app_name, 'start')
        elif args.command == 'compose':
            handler.execute_compose_command(args.app_name, args.file, unknown_args)
        else:
            handler.execute_app_command(args.app_name, args.command)
    except ClientException as e:
        print(f"\nJOB FAILED: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()